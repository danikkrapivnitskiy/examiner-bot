# Telegram — production bot (required when USE_TEST_ENVIRONMENT=false)
TELEGRAM_BOT_TOKEN=dummy

# Telegram — test bot (required when USE_TEST_ENVIRONMENT=true)
TELEGRAM_TEST_BOT_TOKEN=dummy

# PostgreSQL / Supabase (required for Prisma)
#
# DATABASE_URL — Transaction pooler (IPv4-friendly). Use Supabase "Transaction pooler" connection string on port 6543,
# and append ?pgbouncer=true so Prisma knows connections go through PgBouncer (required for pooled runtime queries).
# Example shape (adjust host/user/password/db from your Supabase dashboard):
# DATABASE_URL="postgresql://USER.POOLER_REF:PASSWORD@HOST.region.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public"
#
# DIRECT_URL — Session pooler for migrations (IPv4-friendly). Supabase "Direct connection" often requires IPv6; use the
# "Session pooler" URL on port 5432 instead so prisma migrate deploy / prisma migrate dev can reach Postgres without IPv6.
# Example shape:
# DIRECT_URL="postgresql://USER.POOLER_REF:PASSWORD@HOST.region.pooler.supabase.com:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Redis — keys are prefixed with examiner: in application code (see redis.client.ts)
REDIS_URL="redis://localhost:6379"

# LLM provider: openai | grok (xAI OpenAI-compatible API) | openrouter | gemini
LLM_PROVIDER=openai

# STT (Speech-to-Text) provider: openai | grok
STT_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai — document analysis / question generation)
OPENAI_API_KEY=dummy
OPENAI_MODEL=gpt-4o-mini

# Whisper transcription model (`audio.transcriptions.create`)
STT_MODEL=whisper-1

# Grok / xAI (when LLM_PROVIDER=grok)
GROK_API_KEY=dummy
GROK_MODEL=grok-4.3

# OpenRouter (when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=dummy
OPENROUTER_MODEL=deepseek/deepseek-r1

# Google Gemini (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=dummy
GEMINI_MODEL=gemini-2.5-pro

# Application (NODE_ENV still drives logging / Prisma client verbosity)
NODE_ENV=development
LOG_LEVEL=info

# When true: TELEGRAM_TEST_BOT_TOKEN, TEST_PORT, TEST_WEBHOOK_URL (aligned with tg-ai-friend-bot).
# When false: TELEGRAM_BOT_TOKEN, PORT, WEBHOOK_URL.
USE_TEST_ENVIRONMENT=false

# HTTP webhook server. Defaults: PORT=3000, TEST_PORT=3001
PORT=3000
TEST_PORT=3001

# Full HTTPS webhook URL Telegram POSTs to (path included), e.g. https://your-host/webhook.
# Required when USE_TEST_ENVIRONMENT=false.
WEBHOOK_URL=https://dummy.com

# Required when USE_TEST_ENVIRONMENT=true (CI / isolated webhook targets).
TEST_WEBHOOK_URL=https://dummy.com

# Optional: Telegram secret_token for webhook validation (recommended in production).
TELEGRAM_WEBHOOK_SECRET=dummy

# Support username for users to contact
SUPPORT_USERNAME=dummy_support
