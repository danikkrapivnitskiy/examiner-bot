{
  "name": "examiner-bot",
  "version": "1.0.0",
  "description": "Telegram Examiner MVP bot (standalone)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/application/prompts && cp src/application/prompts/*.md dist/application/prompts/",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "APP_MODE=worker ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "start:worker": "APP_MODE=worker node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,md}'",
    "config:validate": "ts-node src/config/validate.ts",
    "script:analyze-test-pdfs": "npx ts-node --project src/scripts/tsconfig.json src/scripts/analyze-test-pdfs.ts",
    "check:status": "bash scripts/check-status.sh",
    "deploy:code": "bash scripts/deploy-code.sh",
    "deploy:config": "bash scripts/update-config.sh",
    "webhook:set": "bash scripts/set-webhook.sh",
    "docker:build": "docker build -t examiner-bot .",
    "docker:build-push": "bash scripts/docker-build-push.sh",
    "docker:run": "docker-compose -f docker-compose.production.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.production.yml down",
    "docker:logs": "docker-compose -f docker-compose.production.yml logs -f",
    "prepare": "husky"
  },
  "keywords": [
    "telegram",
    "examiner",
    "grammy",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.76.4",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.42.0",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "openai": "^6.35.0",
    "pdf2json": "^4.0.3",
    "reflect-metadata": "^0.2.2",
    "stripe": "^19.3.1",
    "tsyringe": "^4.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
